{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancientsky.github.io/tw_amr_dashboard/api/v1/schema/resistance.schema.json",
  "title": "Resistance dataset (THAS AR annual reports)",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Envelope"
    },
    {
      "type": "object",
      "properties": {
        "dataset": {
          "const": "resistance"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "pathogen",
              "antibiotic",
              "level",
              "ward",
              "setting",
              "specimen",
              "isolates",
              "resistant_pct",
              "precision"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "pathogen": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Za-z0-9_-]*$"
              },
              "antibiotic": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Za-z0-9_-]*$"
              },
              "phenotype": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Za-z0-9_-]*$"
              },
              "level": {
                "enum": [
                  "all",
                  "medical_center",
                  "regional",
                  "district"
                ]
              },
              "ward": {
                "enum": [
                  "all",
                  "icu",
                  "non_icu"
                ]
              },
              "setting": {
                "enum": [
                  "all",
                  "co",
                  "ho"
                ]
              },
              "specimen": {
                "enum": [
                  "all",
                  "blood",
                  "urine",
                  "sputum",
                  "pus",
                  "stool",
                  "csf",
                  "genital"
                ]
              },
              "isolates": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "resistant_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "susceptible_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "ci_low": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "ci_high": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "precision": {
                "enum": [
                  "table",
                  "text",
                  "chart_estimate"
                ]
              },
              "reportYear": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              }
            }
          }
        }
      }
    }
  ]
}
